{
  "manifest_version": 3,
  "name": "Ravenbane Architect \u2014 Character.AI helper",
  "version": "1.0.0",
  "description": "Lets the Ravenbane Architect story app show your Character.AI chats inside its own character pages. Touches nothing except character.ai.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "*://*.character.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ping.js"
      ],
      "matches": [
        "<all_urls>",
        "file:///*"
      ]
    }
  ]
}